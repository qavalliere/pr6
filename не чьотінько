#include <iostream>
using namespace std;

bool isPrime(int number) {
    if (number < 2) return false;
    for (int i = 2; i <= number / i; i++) {
        if (number % i == 0) return false;
    }
    return true;
}

int main() {
    int n, m;
    cout << "Введіть n та m: ";
    if (!(cin >> n >> m) || n > m) {
        cout << "Некоректний проміжок.\n";
        return 1;
    }
    cout << "Прості числа: ";
    bool found = false;
    for (long long i = n; i <= m; i++) {
        if (isPrime(i)) {
            cout << i << " ";
            found = true;
        }
    }
    if (!found) cout << "немає";
    cout << endl;
    return 0;
}
